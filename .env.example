# Public, absolute URL of the deployed site (no trailing slash). Used for canonical
# and Open Graph URLs. Falls back to the Vercel / Netlify deployment URL, then localhost.
NEXT_PUBLIC_SITE_URL=

# Endpoint that receives RSVP submissions as JSON (POST). Unused while
# `rsvp.enabled` is false in src/config/wedding.ts — which it currently is.
NEXT_PUBLIC_RSVP_ENDPOINT=
